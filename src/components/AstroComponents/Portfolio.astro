---
// component import
import Timeline from "@components/AstroComponents/Common/Timeline.astro";

// data import
import education from "@assets/js/data/education";
import research from "@assets/js/data/research";
import Testimonial from "./Testimonial.astro";

// style import
import "./styles/Portfolio.scss";
---

<main class="Portfolio" id="portfolio" data-name="Portfolio">
  <h1>Portfolio</h1>
  <section class="portfolio-container">
    <div class="section-heading">
      <h2>Research</h2>
    </div>
    <Timeline data={research} label="Research positions" />
    <div class="section-heading">
      <h2>Education</h2>
    </div>
    <Timeline data={education} label="Education history" />
    <div class="section-heading">
      <h2>Testimonials</h2>
    </div>
    <Testimonial />
  </section>
</main>
